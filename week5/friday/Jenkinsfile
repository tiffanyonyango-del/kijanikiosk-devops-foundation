pipeline {
    agent {
        docker {
            image 'node:22.17.1-bookworm'
            reuseNode true
        }
    }

    environment {
        APP_DIR = 'week5/friday/app'
        PACKAGE_NAME = 'week5-demo-app'
        BASE_VERSION = '1.0.0'
        NEXUS_URL = 'http://localhost:8081/repository/npm-hosted/'
        NEXUS_CREDENTIALS = 'nexus-creds'
        ARTIFACT_NAME = 'build-output.tar.gz'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Lint') {
            steps {
                dir(env.APP_DIR) {
                    sh 'npm ci'
                    sh 'npm run lint'
                }
            }
        }

        stage('Build') {
            steps {
                dir(env.APP_DIR) {
                    sh 'npm run build'
                }
            }
        }

        stage('Verify') {

            parallel {

                stage('Test') {

                    steps {

                        dir(env.APP_DIR) {

                            sh 'npm test'

                        }

                    }

                }

                stage('Security Audit') {

                    steps {

                        dir(env.APP_DIR) {

                            sh 'npm audit --audit-level=high'

                        }

                    }

                }

            }

        }

        stage('Archive') {

            steps {

                dir(env.APP_DIR) {

                    sh '''
                    tar -czf ${ARTIFACT_NAME} dist package.json package-lock.json
                    '''

                }

                archiveArtifacts artifacts: '**/build-output.tar.gz',
                                 fingerprint: true

            }

        }
                stage('Publish') {
            steps {
                script {
                    env.GIT_SHA = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    env.PACKAGE_VERSION = "${BASE_VERSION}-${env.GIT_SHA}"
                }

                dir(env.APP_DIR) {

                    sh '''
                    npm version ${PACKAGE_VERSION} --no-git-tag-version
                    '''

                    withCredentials([
                        usernamePassword(
                            credentialsId: "${NEXUS_CREDENTIALS}",
                            usernameVariable: 'NEXUS_USER',
                            passwordVariable: 'NEXUS_PASS'
                        )
                    ]) {

                        sh '''
                        cat > .npmrc <<EOF
registry=${NEXUS_URL}
//localhost:8081/repository/npm-hosted/:username=${NEXUS_USER}
//localhost:8081/repository/npm-hosted/:_password=$(printf "%s" "$NEXUS_PASS" | base64 -w0)
//localhost:8081/repository/npm-hosted/:email=admin@example.com
//localhost:8081/repository/npm-hosted/:always-auth=true
EOF

npm publish

rm -f .npmrc
'''
                    }
                }
            }
        }

    }

    post {

        always {

            junit allowEmptyResults: true,
                  testResults: '**/junit.xml'

            cleanWs()

        }

        success {

            echo "Build completed successfully."

            echo "Artifact published to: ${NEXUS_URL}"

        }

        failure {

            echo "Pipeline failed. Review the failed stage before retrying."

        }

        changed {

            echo "Pipeline status changed compared to the previous build."

        }

    }

}